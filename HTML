<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AutoDM Hub - Instagram Automation Dashboard</title>
  
  <!-- Inter Font -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- HTMX for reactive updates -->
  <script src="https://unpkg.com/htmx.org@2.0.2"></script>

  <style>
    :root {
      --bg-dark: #090d16;
      --card-bg: #131b2e;
      --card-border: #1e293b;
      --primary: #38bdf8;
      --primary-hover: #0284c7;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --success: #22c55e;
      --success-bg: rgba(34, 197, 94, 0.15);
      --danger: #ef4444;
      --danger-bg: rgba(239, 68, 68, 0.15);
      --input-bg: #0b1120;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    body {
      background-color: var(--bg-dark);
      color: var(--text-main);
      display: flex;
      min-height: 100vh;
    }

    /* Sidebar Navigation */
    .sidebar {
      width: 260px;
      background: #060911;
      border-right: 1px solid var(--card-border);
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      position: fixed;
      top: 0;
      bottom: 0;
      left: 0;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 2.5rem;
    }

    .brand-icon {
      background: linear-gradient(135deg, #f59e0b, #ec4899, #8b5cf6);
      width: 36px;
      height: 36px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
    }

    .brand h2 {
      font-size: 1.15rem;
      font-weight: 700;
      letter-spacing: -0.5px;
    }

    .nav {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      flex: 1;
    }

    .nav-btn {
      background: transparent;
      border: none;
      color: var(--text-muted);
      text-align: left;
      padding: 0.75rem 1rem;
      border-radius: 8px;
      font-weight: 500;
      font-size: 0.95rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 10px;
      transition: all 0.2s ease;
    }

    .nav-btn:hover {
      background: var(--card-border);
      color: #fff;
    }

    .nav-btn.active {
      background: var(--card-border);
      color: var(--primary);
      font-weight: 600;
    }

    .sidebar-status {
      font-size: 0.8rem;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: 8px;
      padding-top: 1rem;
      border-top: 1px solid var(--card-border);
    }

    .dot-online {
      width: 8px;
      height: 8px;
      background: var(--success);
      border-radius: 50%;
      box-shadow: 0 0 8px var(--success);
    }

    /* Main Container */
    .main-container {
      margin-left: 260px;
      flex: 1;
      padding: 2.5rem 3.5rem;
      max-width: 1300px;
    }

    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2rem;
    }

    .page-title h1 {
      font-size: 1.8rem;
      font-weight: 700;
      letter-spacing: -0.5px;
    }

    .page-title p {
      color: var(--text-muted);
      margin-top: 4px;
      font-size: 0.95rem;
    }

    /* Cards & Stats */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1.25rem;
      margin-bottom: 2rem;
    }

    .card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      padding: 1.5rem;
    }

    .stat-card {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .stat-card .title {
      font-size: 0.85rem;
      color: var(--text-muted);
      font-weight: 500;
    }

    .stat-card .val {
      font-size: 1.7rem;
      font-weight: 700;
      color: #fff;
    }

    /* Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 0.65rem 1.25rem;
      border-radius: 8px;
      font-weight: 600;
      font-size: 0.9rem;
      cursor: pointer;
      border: none;
      transition: background 0.2s ease;
    }

    .btn-primary {
      background: var(--primary);
      color: #060911;
    }

    .btn-primary:hover {
      background: var(--primary-hover);
      color: #fff;
    }

    .btn-secondary {
      background: #1e293b;
      color: #fff;
    }

    .btn-secondary:hover {
      background: #334155;
    }

    .btn-danger-ghost {
      background: transparent;
      color: var(--danger);
      border: none;
      font-size: 1.1rem;
      cursor: pointer;
      padding: 4px 8px;
      border-radius: 4px;
    }

    .btn-danger-ghost:hover {
      background: var(--danger-bg);
    }

    /* Table Styles */
    .table-container {
      overflow-x: auto;
      margin-top: 1rem;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.9rem;
      text-align: left;
    }

    th {
      color: var(--text-muted);
      font-weight: 600;
      padding: 1rem;
      border-bottom: 1px solid var(--card-border);
      text-transform: uppercase;
      font-size: 0.75rem;
      letter-spacing: 0.5px;
    }

    td {
      padding: 1.1rem 1rem;
      border-bottom: 1px solid var(--card-border);
      vertical-align: middle;
    }

    .badge-tag {
      background: #1e293b;
      color: var(--primary);
      padding: 4px 8px;
      border-radius: 4px;
      font-size: 0.8rem;
      font-family: monospace;
      font-weight: 600;
    }

    .badge-status {
      padding: 4px 10px;
      border-radius: 9999px;
      font-size: 0.75rem;
      font-weight: 600;
      border: none;
      cursor: pointer;
    }

    .badge-status.active {
      background: var(--success-bg);
      color: var(--success);
    }

    .badge-status.inactive {
      background: var(--danger-bg);
      color: var(--danger);
    }

    .text-truncate {
      max-width: 220px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* Forms & Inputs */
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
      margin-bottom: 1.25rem;
    }

    label {
      font-size: 0.85rem;
      font-weight: 600;
      color: #e2e8f0;
    }

    input, textarea {
      background: var(--input-bg);
      border: 1px solid var(--card-border);
      border-radius: 8px;
      padding: 0.75rem 1rem;
      color: #fff;
      font-size: 0.9rem;
      outline: none;
      transition: border-color 0.2s;
    }

    input:focus, textarea:focus {
      border-color: var(--primary);
    }

    .hint {
      font-size: 0.75rem;
      color: var(--text-muted);
    }

    /* Post Preview Widget */
    .post-preview-card {
      display: flex;
      gap: 12px;
      background: var(--input-bg);
      border: 1px dashed var(--card-border);
      padding: 12px;
      border-radius: 8px;
      align-items: center;
      margin-bottom: 1.25rem;
    }

    .post-preview-card img {
      width: 55px;
      height: 55px;
      object-fit: cover;
      border-radius: 6px;
    }

    .post-preview-card p {
      font-size: 0.85rem;
      color: var(--text-muted);
      line-height: 1.3;
    }

    /* Modal */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(4px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 999;
    }

    .modal-box {
      width: 100%;
      max-width: 580px;
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 14px;
      padding: 2rem;
      position: relative;
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
    }

    .modal-header h2 {
      font-size: 1.25rem;
    }

    .close-btn {
      background: transparent;
      border: none;
      color: var(--text-muted);
      font-size: 1.5rem;
      cursor: pointer;
    }

    .modal-actions {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 1.5rem;
    }

    /* Webhook Info Box */
    .webhook-box {
      background: #090e1a;
      border: 1px solid var(--card-border);
      border-radius: 8px;
      padding: 1rem;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .meta-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 0.85rem;
    }

    .meta-row code {
      background: #1a2333;
      padding: 4px 8px;
      border-radius: 4px;
      color: var(--primary);
      font-family: monospace;
    }

    .hidden {
      display: none !important;
    }
  </style>
</head>
<body>

  <!-- Sidebar -->
  <aside class="sidebar">
    <div class="brand">
      <div class="brand-icon">⚡</div>
      <h2>AutoDM Hub</h2>
    </div>

    <nav class="nav">
      <button id="navCampaigns" class="nav-btn active" onclick="switchTab('campaigns')">
        <span>📊</span> Campaigns
      </button>
      <button id="navSettings" class="nav-btn" onclick="switchTab('settings')">
        <span>⚙️</span> API & Settings
      </button>
    </nav>

    <div class="sidebar-status">
      <div class="dot-online"></div>
      <span>Engine Running (v20.0 API)</span>
    </div>
  </aside>

  <!-- Main Workspace -->
  <main class="main-container">
    
    <!-- Tab 1: Campaigns View -->
    <section id="tab-campaigns">
      <div class="page-header">
        <div class="page-title">
          <h1>Comment-to-DM Campaigns</h1>
          <p>Automate Instagram comments and private lead conversions on specific reels and posts.</p>
        </div>
        <button class="btn btn-primary" onclick="openModal()">
          <span>+</span> New Campaign
        </button>
      </div>

      <!-- Quick Metrics -->
      <div class="stats-grid">
        <div class="card stat-card">
          <span class="title">Active Automations</span>
          <span class="val" id="statActive">0</span>
        </div>
        <div class="card stat-card">
          <span class="title">Webhook Status</span>
          <span class="val" style="color: var(--success); font-size: 1.3rem;">Healthy</span>
        </div>
        <div class="card stat-card">
          <span class="title">API Mode</span>
          <span class="val" style="font-size: 1.3rem;">Private Reply</span>
        </div>
      </div>

      <!-- Campaigns Table -->
      <div class="card">
        <h3>Active Keyword Triggers</h3>
        <div class="table-container">
          <table>
            <thead>
              <tr>
                <th>Post ID</th>
                <th>Trigger Keywords</th>
                <th>Public Reply</th>
                <th>Private DM</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="campaignsBody">
              <tr>
                <td colspan="6" style="text-align: center; color: var(--text-muted); padding: 2rem;">Loading campaigns...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Tab 2: Settings & Webhook Config -->
    <section id="tab-settings" class="hidden">
      <div class="page-header">
        <div class="page-title">
          <h1>API Credentials & Webhooks</h1>
          <p>Configure official Meta Graph API keys and connect your webhook callback URL.</p>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 1.5rem;">
        <!-- Credentials Form -->
        <div class="card">
          <h3 style="margin-bottom: 1.25rem;">Meta Graph API Credentials</h3>
          <form id="settingsForm" onsubmit="saveSettings(event)">
            <div class="form-group">
              <label>Long-Lived User Access Token</label>
              <input type="password" id="cfgAccessToken" placeholder="EAAB..." required />
              <span class="hint">Requires <code>instagram_manage_comments</code> and <code>instagram_manage_messages</code>.</span>
            </div>

            <div class="form-group">
              <label>Instagram Business Account ID</label>
              <input type="text" id="cfgIgId" placeholder="e.g. 17841400000000000" required />
              <span class="hint">The numeric ID of your connected Instagram Professional account.</span>
            </div>

            <div class="form-group">
              <label>Facebook Page ID (Optional)</label>
              <input type="text" id="cfgPageId" placeholder="e.g. 1029384756" />
            </div>

            <button type="submit" class="btn btn-primary" style="margin-top: 0.5rem;">Save Credentials</button>
          </form>
        </div>

        <!-- Webhook instructions -->
        <div class="card">
          <h3 style="margin-bottom: 1.25rem;">Meta Webhook Configuration</h3>
          <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1rem; line-height: 1.4;">
            Provide these details inside your <strong>Facebook Developer App &gt; Webhooks &gt; Instagram</strong>:
          </p>

          <div class="webhook-box">
            <div class="meta-row">
              <span style="color: var(--text-muted);">Callback URL:</span>
              <code id="webhookUrlDisplay">https://your-domain.com/webhook/instagram</code>
            </div>
            <div class="meta-row">
              <span style="color: var(--text-muted);">Verify Token:</span>
              <code>Defined in your .env</code>
            </div>
            <div class="meta-row">
              <span style="color: var(--text-muted);">Subscription Field:</span>
              <code>comments</code>
            </div>
          </div>

          <div style="margin-top: 1.5rem; font-size: 0.85rem; color: var(--text-muted); line-height: 1.4;">
            <p>💡 <strong>Note on DMs:</strong> The official API sends the first DM under Meta's 7-day Private Reply policy directly linked to the user's comment.</p>
          </div>
        </div>
      </div>
    </section>

  </main>

  <!-- Create Campaign Modal -->
  <div id="campaignModal" class="modal-overlay hidden">
    <div class="modal-box">
      <div class="modal-header">
        <h2>Launch Auto-DM Campaign</h2>
        <button class="close-btn" onclick="closeModal()">&times;</button>
      </div>

      <form onsubmit="submitNewCampaign(event)">
        <div class="form-group">
          <label>Instagram Post ID</label>
          <input type="text" id="modalPostId" placeholder="e.g. 179837264812345" required onblur="fetchPostPreview()" />
          <span class="hint">Graph API media ID for the reel or post.</span>
        </div>

        <!-- Dynamic Post Preview Box -->
        <div id="modalPreviewBox" class="post-preview-card hidden">
          <img id="previewImg" src="" alt="Thumbnail" />
          <p id="previewCaption">Looking up post details...</p>
        </div>

        <div class="form-group">
          <label>Trigger Keywords (comma-separated)</label>
          <input type="text" id="modalKeywords" placeholder="course, guide, تفاصيل, كورس" required />
          <span class="hint">Matching is case-insensitive.</span>
        </div>

        <div class="form-group">
          <label>Public Comment Reply</label>
          <textarea id="modalCommentReply" rows="2" placeholder="بعتلك التفاصيل في الـ DM دلوقتي، شيك على رسايلك 📩" required></textarea>
        </div>

        <div class="form-group">
          <label>Private DM Message (Direct Response)</label>
          <textarea id="modalDmMessage" rows="3" placeholder="أهلاً بيك! ده الرابط المباشر للكورس: https://..." required></textarea>
        </div>

        <div class="modal-actions">
          <button type="button" class="btn btn-secondary" onclick="closeModal()">Cancel</button>
          <button type="submit" class="btn btn-primary">Start Automation</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Client-side SPA Application Logic -->
  <script>
    // Tab Switching
    function switchTab(tab) {
      const isCamp = tab === 'campaigns';
      document.getElementById('tab-campaigns').classList.toggle('hidden', !isCamp);
      document.getElementById('tab-settings').classList.toggle('hidden', isCamp);
      document.getElementById('navCampaigns').classList.toggle('active', isCamp);
      document.getElementById('navSettings').classList.toggle('active', !isCamp);
    }

    // Modal Control
    function openModal() {
      document.getElementById('campaignModal').classList.remove('hidden');
    }
    function closeModal() {
      document.getElementById('campaignModal').classList.add('hidden');
      document.getElementById('modalPreviewBox').classList.add('hidden');
    }

    // Auto-detect dynamic Webhook URL
    document.getElementById('webhookUrlDisplay').innerText = window.location.origin + '/webhook/instagram';

    // Fetch and render campaigns
    async function loadCampaigns() {
      try {
        const res = await fetch('/api/campaigns');
        const data = await res.json();
        const tbody = document.getElementById('campaignsBody');
        tbody.innerHTML = '';

        if (!data || data.length === 0) {
          tbody.innerHTML = `<tr><td colspan="6" style="text-align: center; color: var(--text-muted); padding: 2rem;">No active campaigns. Click "+ New Campaign" to create one.</td></tr>`;
          document.getElementById('statActive').innerText = '0';
          return;
        }

        let activeCount = 0;
        data.forEach(c => {
          if (c.is_active) activeCount++;
          const row = document.createElement('tr');
          row.id = `row-${c.id}`;
          row.innerHTML = `
            <td><code>${c.post_id}</code></td>
            <td><span class="badge-tag">${c.keywords}</span></td>
            <td class="text-truncate">${c.comment_reply}</td>
            <td class="text-truncate">${c.dm_message}</td>
            <td>
              <button class="badge-status ${c.is_active ? 'active' : 'inactive'}" onclick="toggleCampaign(${c.id})">
                ${c.is_active ? 'Active' : 'Paused'}
              </button>
            </td>
            <td>
              <button class="btn-danger-ghost" onclick="deleteCampaign(${c.id})" title="Delete Campaign">🗑</button>
            </td>
          `;
          tbody.appendChild(row);
        });
        document.getElementById('statActive').innerText = activeCount;
      } catch (err) {
        console.error('Failed to load campaigns:', err);
      }
    }

    // Fetch Post Preview on blur
    async function fetchPostPreview() {
      const postId = document.getElementById('modalPostId').value.trim();
      if (!postId) return;

      const previewBox = document.getElementById('modalPreviewBox');
      const previewCaption = document.getElementById('previewCaption');
      const previewImg = document.getElementById('previewImg');

      previewBox.classList.remove('hidden');
      previewCaption.innerText = "Checking Instagram Graph API...";

      try {
        const res = await fetch(`/api/post-preview/${postId}`);
        const data = await res.json();
        if (data.id) {
          previewImg.src = data.thumbnail_url || data.media_url || "https://placehold.co/100x100?text=Post";
          previewCaption.innerText = data.caption ? data.caption.substring(0, 90) + '...' : 'Instagram media confirmed.';
        } else {
          previewCaption.innerText = "Post found (ID verified).";
          previewImg.src = "https://placehold.co/100x100?text=Reel";
        }
      } catch (err) {
        previewCaption.innerText = "Post ID recorded (preview unavailable).";
      }
    }

    // Create Campaign Form Submit
    async function submitNewCampaign(e) {
      e.preventDefault();
      const payload = {
        post_id: document.getElementById('modalPostId').value.trim(),
        keywords: document.getElementById('modalKeywords').value.trim(),
        comment_reply: document.getElementById('modalCommentReply').value.trim(),
        dm_message: document.getElementById('modalDmMessage').value.trim(),
        is_active: true
      };

      const res = await fetch('/api/campaigns', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (res.ok) {
        closeModal();
        loadCampaigns();
      } else {
        const err = await res.json();
        alert(err.detail || 'Could not save campaign.');
      }
    }

    // Toggle Active State
    async function toggleCampaign(id) {
      const res = await fetch(`/api/campaigns/${id}/toggle`, { method: 'POST' });
      if (res.ok) loadCampaigns();
    }

    // Delete Campaign
    async function deleteCampaign(id) {
      if (!confirm('Are you sure you want to delete this automation trigger?')) return;
      const res = await fetch(`/api/campaigns/${id}`, { method: 'DELETE' });
      if (res.ok) loadCampaigns();
    }

    // Load Settings
    async function loadSettings() {
      try {
        const res = await fetch('/api/config');
        const data = await res.json();
        if (data.instagram_business_account_id) {
          document.getElementById('cfgIgId').value = data.instagram_business_account_id;
        }
        if (data.page_id) {
          document.getElementById('cfgPageId').value = data.page_id;
        }
      } catch (err) {
        console.error('Failed to load settings:', err);
      }
    }

    // Save Settings
    async function saveSettings(e) {
      e.preventDefault();
      const payload = {
        access_token: document.getElementById('cfgAccessToken').value.trim(),
        instagram_business_account_id: document.getElementById('cfgIgId').value.trim(),
        page_id: document.getElementById('cfgPageId').value.trim() || null
      };

      const res = await fetch('/api/config', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (res.ok) {
        alert('Credentials saved successfully!');
      } else {
        alert('Error saving credentials.');
      }
    }

    // Initialize Dashboard
    window.addEventListener('DOMContentLoaded', () => {
      loadCampaigns();
      loadSettings();
    });
  </script>
</body>
</html>
